# Copy to .env.local and fill with your values. Do not commit .env.local.

# --- Supabase (Settings → API) ---
# Server (API routes, DB)
SUPABASE_URL=your supabase url
SUPABASE_ANON_KEY=your supabase anon key
SUPABASE_SERVICE_ROLE_KEY=your supabase service role key

# Client (browser) – BẮT BUỘC cho trang Login. Điền cùng giá trị với SUPABASE_URL và SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=your supabase url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your supabase anon key

# --- Grok API (optional; unused if using Groq) ---
# GROK_API_KEY=sk_xxxxx

# --- Groq API (Part 5 – agent chat, free tier) ---
# Get key at https://console.groq.com
GROQ_API_KEY=your groq api key

# --- Demo merchant: mỗi loại project 1 key (food / flight / ...) ---
# Food: (widget/embed sau) gửi x-api-key = key này
NEXT_PUBLIC_DEMO_MERCHANT_API_KEY_FOOD=your demo merchant api key for food
# Flight (vé máy bay): travel project / travel-demo
NEXT_PUBLIC_DEMO_MERCHANT_API_KEY_FLIGHT=your demo merchant api key for flight
